( $, $config ) => {
    config.lsp = {};
    config.plugin = [
        "opencode-intellisearch",
        "@tarquinen/opencode-dcp@3.1.13",
        "opencode-agent-memory"
    ];
    config.compaction = {
        auto: false;
        prune: false;
    };
    config.tool_output = {
        max_lines: 5000;
        max_bytes: 204800;
    };
    config.experimental = {
        mcp_timeout: 120000;
    };
}
