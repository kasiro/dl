// Сгенерировано из https://opencode.ai/config.json
// Не редактировать вручную.
schema => {
    class Config {
        /// JSON schema reference for configuration validation
        "$schema"?: string;
        /// Default shell to use for terminal and shell tool execution
        shell?: string;
        /// Default model to use when no session or agent model is selected
        model?: string
        | {
            providerID: string;
            model: string;
            variant?: string;
        };
        /// Default primary agent to use when no session agent is selected
        default_agent?: string;
        /// Disable updates, notify when one is available, or install updates automatically
        update?: enum { "disable" | "notify" | "auto" };
        /// Control whether sessions may be shared manually, automatically, or not at all
        share?: enum { "manual" | "auto" | "disabled" };
        /// Enterprise sharing service configuration
        enterprise?: {
            /// Enterprise URL
            url?: string;
        };
        /// Username displayed in conversations and used for telemetry identity
        username?: string;
        /// Ordered tool permission rules applied to agent tool use
        permissions?: [PermissionRule];
        /// Ordered policies controlling access to providers, tools, and integrations
        policies?: [
            {
                action: enum { "provider.use" | "tool.use" | "integration.use" };
                resource: string;
                effect: enum { "allow" | "deny" };
            }
        ];
        /// Named built-in agent overrides and custom agent definitions
        agents?: map<AgentEncoded>;
        /// Enable snapshots used for undo and revert behavior
        snapshots?: boolean;
        /// Filesystem watcher configuration
        watcher?: {
            ignore?: [string];
        };
        /// Enable built-in formatters or configure formatter overrides
        formatter?: boolean | map<FormatterEntryEncoded>;
        /// Enable built-in language servers or configure server overrides
        lsp?: boolean
        | map<
            {
                disabled: enum { true };
            }
            | LSPServerEncoded
        >;
        /// Media processing configuration
        media?: {
            image?: {
                auto_resize?: boolean;
                max_width?: integer;
                max_height?: integer;
                max_base64_bytes?: integer;
            };
        };
        /// Tool output truncation thresholds
        tool_output?: {
            /// Maximum lines of tool output before it is truncated and saved to disk (default: 2000)
            max_lines?: integer;
            /// Maximum bytes of tool output before it is truncated and saved to disk (default: 51200)
            max_bytes?: integer;
        };
        /// MCP server configuration
        mcp?: {
            timeout?: {
                startup?: integer;
                catalog?: integer;
                execution?: integer;
            };
            servers?: map<McpLocalConfigEncoded | McpRemoteConfigEncoded>;
        };
        /// Conversation compaction behavior
        compaction?: {
            /// Enable automatic compaction when context is full (default: true)
            auto?: boolean;
            keep?: {
                tokens?: integer;
            };
            buffer?: integer;
            /// Enable pruning of old tool outputs (default: false)
            prune?: boolean;
            /// Maximum number of recent user turns, including their following assistant/tool responses, to keep verbatim during compaction. By default retention is limited only by the preserved token budget.
            tail_turns?: integer;
            /// Maximum number of tokens from recent turns to preserve verbatim after compaction
            preserve_recent_tokens?: integer;
            /// Token buffer for compaction. Leaves enough window to avoid overflow during compaction.
            reserved?: integer;
        };
        /// Additional paths or URLs to discover skills from
        skills?: [string]
        | {
            /// Additional paths to skill folders
            paths?: [string];
            /// URLs to fetch skills from (e.g., https://example.com/.well-known/skills/)
            urls?: [string];
        };
        /// Named slash command definitions
        commands?: map<CommandEncoded>;
        /// Additional paths or URLs supplying ambient instructions
        instructions?: [string];
        /// Named local directories or Git repositories available as external context
        references?: map<string | ReferenceGitEncoded | ReferenceLocalEncoded>;
        /// Web search provider selection
        websearch?: enum { false } | ConfigWebSearchInfoEncoded;
        /// Ordered plugin enablement directives and external package declarations
        plugins?: [string | PluginEntryEncoded];
        /// Directory defaults for local worktree creation
        worktree?: Worktree;
        /// Keep recently active sessions warm with transient model requests (default: false)
        warming?: boolean | WarmingEncoded;
        providers?: map<ProviderEncoded>;
        experimental?: {
            portable_shell_scanner?: boolean;
            todo?: boolean;
            background_compaction?: boolean;
            subagent_depth?: integer;
            location_idle_timeout?: string | enum { false };
            /// Policy statements applied to supported resources, such as provider access
            policies?: [
                {
                    action: enum { "provider.use" | "tool.use" | "integration.use" };
                    resource: string;
                    effect: enum { "allow" | "deny" };
                }
            ];
            disable_paste_summary?: boolean;
            /// Enable the batch tool
            batch_tool?: boolean;
            /// Enable OpenTelemetry spans for AI SDK calls (using the 'experimental_telemetry' flag)
            openTelemetry?: boolean;
            /// Tools that should only be available to primary agents.
            primary_tools?: [string];
            /// Continue the agent loop when a tool call is denied
            continue_loop_on_deny?: boolean;
            /// Timeout in milliseconds for model context protocol (MCP) requests
            mcp_timeout?: integer;
        };
        /// Log level
        logLevel?: enum { "DEBUG" | "INFO" | "WARN" | "ERROR" };
        /// Server configuration for opencode serve and web commands
        server?: ServerConfig;
        /// Command configuration, see https://opencode.ai/docs/commands
        command?: map<
            {
                template: string;
                description?: string;
                agent?: string;
                model?: any;
                variant?: string;
                subtask?: boolean;
            }
        >;
        /// @deprecated Use 'references' field instead. Named git or local directory references
        reference?: map<string | ConfigV2ReferenceGit | ConfigV2ReferenceLocal>;
        /// Enable or disable snapshot tracking. When false, filesystem snapshots are not recorded and undoing or reverting will not undo/redo file changes. Defaults to true.
        snapshot?: boolean;
        plugin?: [string | [any]];
        /// @deprecated Use 'share' field instead. Share newly created sessions automatically
        autoshare?: boolean;
        /// Check for new versions and show an update notice. Updates are never installed automatically; run /update or `opencode upgrade`. Set to false to disable update checks. true and 'notify' behave the same
        autoupdate?: boolean | enum { "notify" };
        /// Disable providers that are loaded automatically
        disabled_providers?: [string];
        /// When set, ONLY these providers will be enabled. All other providers will be ignored
        enabled_providers?: [string];
        /// Small model to use for tasks like title generation in the format of provider/model
        small_model?: any;
        /// Maximum subagent nesting depth. Defaults to 1, which prevents subagents from launching subagents.
        subagent_depth?: integer;
        /// @deprecated Use `agent` field instead.
        mode?: {
            build?: AgentConfig;
            plan?: AgentConfig;
        };
        /// Agent configuration, see https://opencode.ai/docs/agents
        agent?: {
            plan?: AgentConfig;
            build?: AgentConfig;
            general?: AgentConfig;
            explore?: AgentConfig;
            title?: AgentConfig;
            summary?: AgentConfig;
            compaction?: AgentConfig;
        };
        /// Custom provider configurations and model overrides
        provider?: map<ProviderConfig>;
        /// @deprecated Always uses stretch layout.
        layout?: enum { "auto" | "stretch" };
        permission?: enum { "ask" | "allow" | "deny" }
        | {
            read?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
            edit?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
            glob?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
            grep?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
            list?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
            bash?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
            task?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
            external_directory?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
            todowrite?: enum { "ask" | "allow" | "deny" };
            question?: enum { "ask" | "allow" | "deny" };
            webfetch?: enum { "ask" | "allow" | "deny" };
            websearch?: enum { "ask" | "allow" | "deny" };
            lsp?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
            doom_loop?: enum { "ask" | "allow" | "deny" };
            skill?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
        };
        tools?: map<boolean>;
        /// Attachment processing configuration, including image size limits and resizing behavior
        attachment?: AttachmentConfig;
    };
    class ServerConfig {
        /// Port to listen on
        port?: integer;
        /// Hostname to listen on
        hostname?: string;
        /// Enable mDNS service discovery
        mdns?: boolean;
        /// Custom domain name for mDNS service (default: opencode.local)
        mdnsDomain?: string;
        /// Additional domains to allow for CORS
        cors?: [string];
    };
    class ConfigV2ReferenceGit {
        repository: string;
        branch?: string;
        description?: string;
        hidden?: boolean;
    };
    class ConfigV2ReferenceLocal {
        path: string;
        description?: string;
        hidden?: boolean;
    };
    class AgentConfig {
        model?: any;
        /// Default model variant for this agent (applies only when using the agent's configured model).
        variant?: string;
        temperature?: number;
        top_p?: number;
        prompt?: string;
        /// @deprecated Use 'permission' field instead
        tools?: map<boolean>;
        disable?: boolean;
        /// Description of when to use the agent
        description?: string;
        mode?: enum { "subagent" | "primary" | "all" };
        /// Hide this subagent from the @ autocomplete menu (default: false, only applies to mode: subagent)
        hidden?: boolean;
        options?: {};
        /// Hex color code (e.g., #FF5733) or theme color (e.g., primary)
        color?: string | enum { "primary" | "secondary" | "accent" | "success" | "warning" | "error" | "info" };
        /// Maximum number of agentic iterations before forcing text-only response
        steps?: integer;
        /// @deprecated Use 'steps' field instead.
        maxSteps?: integer;
        permission?: enum { "ask" | "allow" | "deny" }
        | {
            read?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
            edit?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
            glob?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
            grep?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
            list?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
            bash?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
            task?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
            external_directory?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
            todowrite?: enum { "ask" | "allow" | "deny" };
            question?: enum { "ask" | "allow" | "deny" };
            webfetch?: enum { "ask" | "allow" | "deny" };
            websearch?: enum { "ask" | "allow" | "deny" };
            lsp?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
            doom_loop?: enum { "ask" | "allow" | "deny" };
            skill?: enum { "ask" | "allow" | "deny" } | map<enum { "ask" | "allow" | "deny" }>;
        };
    };
    class ProviderConfig {
        api?: string;
        name?: string;
        env?: [string];
        id?: string;
        npm?: string;
        whitelist?: [string];
        blacklist?: [string];
        options?: {
            apiKey?: string;
            baseURL?: string;
            /// GitHub Enterprise URL for copilot authentication
            enterpriseUrl?: string;
            /// Enable promptCacheKey for this provider (default false)
            setCacheKey?: boolean;
            /// Timeout in milliseconds for full requests to this provider. Set to false to disable timeout.
            timeout?: integer | enum { false };
            /// Timeout in milliseconds to wait for response headers (default: 300000). Set to false to disable timeout.
            headerTimeout?: integer | enum { false };
            /// Timeout in milliseconds between streamed SSE chunks for this provider (default: 300000). If no chunk arrives within this window, the request is aborted. Set to false to disable timeout.
            chunkTimeout?: integer | enum { false };
        };
        models?: map<
            {
                id?: string;
                name?: string;
                family?: string;
                release_date?: string;
                attachment?: boolean;
                reasoning?: boolean;
                temperature?: boolean;
                tool_call?: boolean;
                interleaved?: boolean
                | enum { "reasoning" | "reasoning_content" | "reasoning_text" } | string
                | {
                    field: enum { "reasoning" | "reasoning_content" | "reasoning_text" } | string;
                };
                cost?: {
                    input: number;
                    output: number;
                    cache_read?: number;
                    cache_write?: number;
                    context_over_200k?: {
                        input: number;
                        output: number;
                        cache_read?: number;
                        cache_write?: number;
                    };
                };
                limit?: {
                    context: number;
                    input?: number;
                    output: number;
                };
                modalities?: {
                    input?: [enum { "text" | "audio" | "image" | "video" | "pdf" }];
                    output?: [enum { "text" | "audio" | "image" | "video" | "pdf" }];
                };
                experimental?: boolean;
                status?: enum { "alpha" | "beta" | "deprecated" | "active" };
                provider?: {
                    npm?: string;
                    api?: string;
                };
                options?: {};
                headers?: map<string>;
                /// Variant-specific configuration
                variants?: map<
                    {
                        /// Disable this variant for the model
                        disabled?: boolean;
                    }
                >;
            }
        >;
    };
    class McpLocalConfig {
        /// Type of MCP server connection
        type: enum { "local" };
        /// Command and arguments to run the MCP server
        command: [string];
        /// Working directory for the MCP server process. Relative paths resolve from the workspace directory.
        cwd?: string;
        /// Environment variables to set when running the MCP server
        environment?: map<string>;
        /// Enable or disable the MCP server on startup
        enabled?: boolean;
        /// Timeout in ms for MCP server requests. Defaults to 5000 (5 seconds) if not specified.
        timeout?: integer;
    };
    class McpOAuthConfig {
        /// OAuth client ID. If not provided, dynamic client registration (RFC 7591) will be attempted.
        clientId?: string;
        /// OAuth client secret (if required by the authorization server)
        clientSecret?: string;
        /// OAuth scopes to request during authorization
        scope?: string;
        /// Port for the local OAuth callback server (default: 19876). Shorthand for redirectUri when only the port needs changing. Ignored if redirectUri is set.
        callbackPort?: integer;
        /// OAuth redirect URI (default: http://127.0.0.1:19876/mcp/oauth/callback).
        redirectUri?: string;
    };
    class McpRemoteConfig {
        /// Type of MCP server connection
        type: enum { "remote" };
        /// URL of the remote MCP server
        url: string;
        /// Enable or disable the MCP server on startup
        enabled?: boolean;
        /// Headers to send with the request
        headers?: map<string>;
        /// OAuth authentication configuration for the MCP server. Set to false to disable OAuth auto-detection.
        oauth?: McpOAuthConfig | enum { false };
        /// Timeout in ms for MCP server requests. Defaults to 5000 (5 seconds) if not specified.
        timeout?: integer;
    };
    class ImageAttachmentConfig {
        /// Resize images before sending them to the model when they exceed configured limits (default: true)
        auto_resize?: boolean;
        /// Maximum image width before resizing or rejecting the attachment (default: 2000)
        max_width?: integer;
        /// Maximum image height before resizing or rejecting the attachment (default: 2000)
        max_height?: integer;
        /// Maximum base64 payload bytes for an image attachment (default: 5242880)
        max_base64_bytes?: integer;
    };
    class AttachmentConfig {
        /// Image attachment configuration
        image?: ImageAttachmentConfig;
    };
    class ConfigV2ExperimentalPolicy {
        action: enum { "provider.use" };
        effect: enum { "allow" | "deny" };
        resource: string;
    };
    class PermissionRule {
        action: string;
        resource: string;
        effect: enum { "allow" | "deny" | "ask" };
    };
    class AgentEncoded {
        model?: string
        | {
            providerID: string;
            model: string;
            variant?: string;
        };
        request?: {
            headers?: map<string>;
            body?: {};
        };
        system?: string;
        description?: string;
        mode?: enum { "subagent" | "primary" | "all" };
        hidden?: boolean;
        color?: string;
        steps?: integer;
        disabled?: boolean;
        permissions?: [PermissionRule];
    };
    class FormatterEntryEncoded {
        disabled?: boolean;
        command?: [string];
        environment?: map<string>;
        extensions?: [string];
    };
    class LSPServerEncoded {
        command: [string];
        extensions?: [string];
        disabled?: boolean;
        env?: map<string>;
        initialization?: {};
    };
    class McpLocalConfigEncoded {
        type: enum { "local" };
        command: [string];
        cwd?: string;
        environment?: map<string>;
        disabled?: boolean;
        codemode?: boolean;
        timeout?: {
            startup?: integer;
            catalog?: integer;
            execution?: integer;
        };
        protocol?: enum { "legacy" | "auto" | "2026-07-28" };
    };
    class McpOAuthConfigEncoded {
        client_id?: string;
        client_secret?: string;
        scope?: string;
        callback_port?: integer;
        redirect_uri?: string;
        auth_server_metadata_url?: string;
    };
    class McpRemoteConfigEncoded {
        type: enum { "remote" };
        url: string;
        headers?: map<string>;
        oauth?: McpOAuthConfigEncoded | enum { false };
        disabled?: boolean;
        codemode?: boolean;
        timeout?: {
            startup?: integer;
            catalog?: integer;
            execution?: integer;
        };
        protocol?: enum { "legacy" | "auto" | "2026-07-28" };
    };
    class CommandEncoded {
        template: string;
        description?: string;
        agent?: string;
        model?: string
        | {
            providerID: string;
            model: string;
            variant?: string;
        };
        subagent?: boolean;
        /// Deprecated alias for subagent.
        subtask?: boolean;
    };
    class ReferenceGitEncoded {
        repository: string;
        branch?: string;
        description?: string;
        hidden?: boolean;
    };
    class ReferenceLocalEncoded {
        path: string;
        description?: string;
        hidden?: boolean;
    };
    class ConfigWebSearchInfoEncoded {
        provider: enum { "random" } | string;
    };
    class PluginEntryEncoded {
        package: string;
        options?: {};
    };
    class Worktree {
        directory: string;
    };
    class WarmingEncoded {
        prompt?: string;
        interval?: string;
        duration?: string;
    };
    class ProviderCompatibility {
        reasoningField?: enum { "reasoning" | "reasoning_content" | "reasoning_text" } | string;
        requireReasoning?: boolean;
        maxTokensField?: enum { "max_completion_tokens" | "max_tokens" };
        requireFinishReason?: boolean;
        requireAssistantAfterTool?: boolean;
        supportsPromptCacheKey?: boolean;
        streamUsage?: boolean;
        cacheFormat?: enum { "anthropic" | "alibaba" };
    };
    class ProviderSettings {
        timeout?: number | enum { false };
        headerTimeout?: number | enum { false };
        chunkTimeout?: number | enum { false };
        compaction?: {
            type: enum { "summary" };
        }
        | {
            type: enum { "native" };
        };
        transport?: enum { "http" | "websocket" };
        encoding?: enum { "zstd" | "gzip" | "none" };
    };
    class ModelCompatibility {
        reasoningField?: enum { "reasoning" | "reasoning_content" | "reasoning_text" } | string;
        requireReasoning?: boolean;
        maxTokensField?: enum { "max_completion_tokens" | "max_tokens" };
        requireFinishReason?: boolean;
        requireAssistantAfterTool?: boolean;
        supportsPromptCacheKey?: boolean;
        streamUsage?: boolean;
        cacheFormat?: enum { "anthropic" | "alibaba" };
        supportsThinkingBlockBinding?: boolean;
        supportsEffortUpdates?: boolean;
    };
    class ModelSettings {
        compaction?: {
            type: enum { "summary" };
        }
        | {
            type: enum { "native" };
        };
        encoding?: enum { "zstd" | "gzip" | "none" };
    };
    class ModelCapabilities {
        tools?: boolean;
        input?: [string];
        output?: [string];
        temperature?: boolean;
        reasoning?: {
            supported: enum { false };
        }
        | {
            supported: enum { true };
            toggle?: boolean;
            effort?: [string];
            budget?: {
                min?: integer;
                max?: integer;
            };
        };
    };
    class ModelCostEncoded {
        tier?: {
            type: enum { "context" };
            size: integer;
        };
        input: number;
        output: number;
        cache?: {
            read?: number;
            write?: number;
        };
    };
    class ModelEncoded {
        modelID?: string;
        family?: string;
        name?: string;
        /// Release date as YYYY-MM-DD or YYYY-MM
        releaseDate?: string;
        compatibility?: ModelCompatibility;
        package?: string;
        settings?: ModelSettings;
        headers?: map<string>;
        body?: {};
        capabilities?: ModelCapabilities;
        variants?: [
            {
                id: string;
                settings?: ModelSettings;
                headers?: map<string>;
                body?: {};
            }
        ];
        cost?: ModelCostEncoded | [ModelCostEncoded];
        disabled?: boolean;
        limit?: {
            context?: integer;
            input?: integer;
            output?: integer;
        };
    };
    class ProviderEncoded {
        canonical?: string;
        name?: string;
        env?: [string];
        package?: string;
        compatibility?: ProviderCompatibility;
        settings?: ProviderSettings;
        headers?: map<string>;
        body?: {};
        models?: map<ModelEncoded>;
    };
}
