{
  "schema": "https://opencode.ai/config.json",
  "npm": {
    "openaicomp": "@ai-sdk/openai-compatible",
    "voidrot": "@voidrot/openai-featherless-compatible"
  },
  "providers": {
    "localproxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "localproxy",
      "options": {
        "baseURL": "http://localhost:9625/v1"
      },
      "models": {
        "free-gemini-2.5-pro": {
          "name": "free-gemini-2.5-pro"
        },
        "free-minimax-m2.7": {
          "name": "free-minimax-m2.7"
        },
        "free-claude-haiku-4-5-20251001": {
          "name": "free-claude-haiku-4-5-20251001"
        },
        "free-gemini-2.5-flash": {
          "name": "free-gemini-2.5-flash"
        },
        "free-qwen3.5-plus": {
          "name": "free-qwen3.5-plus"
        },
        "free-qwen3.5-flash": {
          "name": "free-qwen3.5-flash"
        },
        "free-minimax-m2.5": {
          "name": "free-minimax-m2.5"
        },
        "free-gemini-2.5-flash-lite": {
          "name": "free-gemini-2.5-flash-lite"
        },
        "free-gemini-3-flash-preview": {
          "name": "free-gemini-3-flash-preview"
        }
      }
    },
    "deepseek-proxy": {
      "npm": "@voidrot/openai-featherless-compatible",
      "name": "deepseek-proxy",
      "options": {
        "baseURL": "http://localhost:9626/v1",
        "toolCallFallback": "auto",
        "useCompletionUrls": true
      },
      "models": {
        "deepseek/deepseek-v4.1-flash": {
          "name": "deepseek/deepseek-v4.1-flash"
        }
      }
    },
    "zen-free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "zen-free",
      "options": {
        "baseURL": "http://localhost:9627/v1"
      },
      "models": {
        "deepseek-v4-flash-free": {
          "name": "deepseek-v4-flash-free"
        },
        "big-pickle": {
          "name": "big-pickle"
        },
        "mimo-v2.6-flash-free": {
          "name": "mimo-v2.6-flash-free"
        }
      }
    }
  },
  "mcp": {
    "deepwiki": {
      "name": "deepwiki",
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "headers": {},
      "timeout": 120000
    },
    "sequential-thinking": {
      "name": "sequential-thinking",
      "type": "local",
      "command": [
        "/home/kasiro/.npm-global/bin/mcp-server-sequential-thinking"
      ],
      "headers": {},
      "timeout": 120000
    },
    "context7": {
      "name": "context7",
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ctx7sk-418a5f6a-2b9c-4caa-94e2-573821193500"
      },
      "timeout": 120000
    },
    "lightpanda": {
      "name": "lightpanda",
      "type": "local",
      "command": [
        "/home/kasiro/.npm-global/bin/lightpanda-mcp"
      ],
      "headers": {
        "LIGHTPANDA_DISABLE_TELEMETRY": "true"
      },
      "timeout": 60000
    },
    "deploychan": {
      "name": "deploychan",
      "type": "remote",
      "url": "https://mcp.deploychan.webcam/mcp",
      "headers": {},
      "timeout": 120000
    }
  },
  "config": {
    "permission": {
      "bash": {
        "*find*": "deny",
        "*grep*": "deny",
        "*npm*": "deny",
        "*sqlite*": "ask",
        "*opencode*": "ask"
      },
      "glob": "deny",
      "grep": "deny",
      "websearch": "deny"
    },
    "agent": {
      "jarvis": {
        "permission": {
          "edit": {
            "*": "deny"
          },
          "bash": {
            "*": "deny"
          },
          "websearch": "deny",
          "webfetch": "deny",
          "deepwiki_*": "deny",
          "context7_*": "deny",
          "lightpanda_*": "deny"
        }
      },
      "title": {
        "model": "opencode/big-pickle"
      },
      "general": {
        "permission": {
          "edit": {
            "*": "allow"
          },
          "bash": {
            "*": "allow",
            "*grep*": "deny",
            "*find*": "deny",
            "*npx*": "deny",
            "*npm*": "deny",
            "*sqlite*": "ask"
          },
          "websearch": "deny",
          "webfetch": "deny",
          "skill": {
            "agent-delegation": "deny",
            "jarvis-cycles": "deny"
          }
        },
        "tools": {
          "glob": false,
          "grep": false,
          "sequential-thinking_*": true,
          "deepwiki_*": true,
          "context7_*": true,
          "lightpanda_*": true,
          "memory_set": false,
          "memory_replace": false,
          "memory_list": false
        }
      },
      "explore": {
        "disable": true
      }
    },
    "agents": {
      "default": "general"
    },
    "lsp": {},
    "plugin": [
      "opencode-intellisearch",
      "@tarquinen/opencode-dcp@3.1.13",
      "opencode-agent-memory"
    ],
    "compaction": {
      "auto": false,
      "prune": false
    },
    "tool_output": {
      "max_lines": 5000,
      "max_bytes": 204800
    },
    "experimental": {
      "mcp_timeout": 120000
    }
  }
}
